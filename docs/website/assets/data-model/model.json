      "PK id",
      "FK user_id -> users",
      "provider, provider_subject [UQ]",
      "password_hash [nullable]"
    ],
    "kyc_verifications": [
      "PK id",
      "FK user_id -> users",
      "FK document_version_id -> document_versions",
      "status, verified_at"
    ],
