      "FK created_by_user_id -> users",
      "status, revision",
      "disputed_amount_cents"
    ],
    "case_parties": [
      "PK id",
      "FK case_id -> mediation_cases",
      "FK user_id? -> users",
      "FK company_id? -> companies",
      "FK company_revision_id? -> company_revisions",
      "role, party_type"
    ],
    "case_representations": [
      "PK id",
      "FK case_party_id -> case_parties",
      "FK representation_id -> company_representations",
